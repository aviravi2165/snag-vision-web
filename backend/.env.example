# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/siteiq

# Cohere API
COHERE_API_KEY=your_cohere_api_key_here

# Google Cloud Storage
GCS_BUCKET_NAME=siteiq-media
GCS_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=./gcs-credentials.json

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# App
SECRET_KEY=your_super_secret_key_change_this
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Gemini (photo analysis)
gemini_api_key=your_gemini_api_key_here
# Optional. Which model analyses photos, and the models tried in order if it is
# overloaded (503) or retired (404). Defaults: gemini-3.8-flash, then 3.6, then 3.5.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
